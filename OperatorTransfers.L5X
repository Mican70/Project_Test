<Rung Number="30" Type="N">
<Text>
<![CDATA[EQU(Month_FIFO_CTL.POS,1)ONS(OneShot.12)MOV(Month_FIFO[12],Month12);]]>
</Text>
</Rung>
<Rung Number="31" Type="N">
<Text>
<![CDATA[EQU(DATE_TIME[1],12)MOV(Current_Month_Flow,Month12);]]>
