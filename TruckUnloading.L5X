<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[GSV(WallClockTime,,LocalDateTime,DATE_TIME[0]);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[MOV(Daily_Flow,Current_Day)ADD(Daily_Flow,Current_Week_Flow_temp,Current_Week_Flow)ADD(Daily_Flow,Current_Month_Flow_temp,Current_Month_Flow);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[EQU(DATE_TIME[3],23)EQU(DATE_TIME[4],59)EQU(DATE_TIME[5],59)GEQ(DATE_TIME[6],500000)ONS(OneShot.15)FFL(Daily_Flow,Daily_FIFO[0],Daily_FIFO_CTL,?,?)[[MOV(Current_Day,Previous_Day_Flow) ,MOV(Current_Week_Flow,Current_Week_Flow_temp) MOV(Current_Month_Flow,Current_Month_Flow_temp) ] CTU(Day_CTR,?,?) ,[LES(Daily_FIFO_CTL.POS,8) MOV(Daily_FIFO_CTL.POS,Weekly_Flow_AVG_CTL.LEN) ,GEQ(Daily_FIFO_CTL.POS,8) MOV(7,Weekly_Flow_AVG_CTL.LEN) ,AVE(Daily_FIFO[0],0,Daily_Flow_AVG,Weekly_Flow_AVG_CTL,?,?) ] ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(Day_CTR.DN)MOV(Current_Week_Flow,Previous_Week_Flow)MOV(0,Current_Week_Flow_temp)MOV(0,Current_Week_Flow)RES(Day_CTR);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(Daily_FIFO_CTL.DN)FFU(Daily_FIFO[0],FIFO_Scrap,Daily_FIFO_CTL,?,?);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[EQU(DATE_TIME[3],0)EQU(DATE_TIME[4],0)EQU(DATE_TIME[5],0)[EQU(Daily_FIFO_CTL.POS,1) MOV(Daily_FIFO[0],Day1) ,EQU(Daily_FIFO_CTL.POS,2) MOV(Daily_FIFO[0],Day2) MOV(Daily_FIFO[1],Day1) ,EQU(Daily_FIFO_CTL.POS,3) MOV(Daily_FIFO[0],Day3) MOV(Daily_FIFO[1],Day2) MOV(Daily_FIFO[2],Day1) ,EQU(Daily_FIFO_CTL.POS,4) MOV(Daily_FIFO[0],Day4) MOV(Daily_FIFO[1],Day3) MOV(Daily_FIFO[2],Day2) MOV(Daily_FIFO[3],Day1) ,EQU(Daily_FIFO_CTL.POS,5) MOV(Daily_FIFO[0],Day5) MOV(Daily_FIFO[1],Day4) MOV(Daily_FIFO[2],Day3) MOV(Daily_FIFO[3],Day2) MOV(Daily_FIFO[4],Day1) ,EQU(Daily_FIFO_CTL.POS,6) MOV(Daily_FIFO[0],Day6) MOV(Daily_FIFO[1],Day5) MOV(Daily_FIFO[2],Day4) MOV(Daily_FIFO[3],Day3) MOV(Daily_FIFO[4],Day2) MOV(Daily_FIFO[5],Day1) ,EQU(Daily_FIFO_CTL.POS,7) MOV(Daily_FIFO[0],Day7) MOV(Daily_FIFO[1],Day6) MOV(Daily_FIFO[2],Day5) MOV(Daily_FIFO[3],Day4) MOV(Daily_FIFO[4],Day3) MOV(Daily_FIFO[5],Day2) MOV(Daily_FIFO[6],Day1) ,EQU(Daily_FIFO_CTL.POS,8) MOV(Daily_FIFO[0],Day8) MOV(Daily_FIFO[1],Day7) MOV(Daily_FIFO[2],Day6) MOV(Daily_FIFO[3],Day5) MOV(Daily_FIFO[4],Day4) MOV(Daily_FIFO[5],Day3) MOV(Daily_FIFO[6],Day2) MOV(Daily_FIFO[7],Day1) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[EQU(Current_Month,0)MOV(DATE_TIME[1],Current_Month);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[NEQ(DATE_TIME[1],Current_Month)MOV(DATE_TIME[1],Month_FIFO_CTL.POS)FFL(Current_Month_Flow,Month_FIFO[0],Month_FIFO_CTL,?,?)MOV(0,Current_Month_Flow_temp)MOV(0,Current_Month_Flow)MOV(DATE_TIME[1],Current_Month);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[EQU(Month_FIFO_CTL.POS,2)ONS(OneShot.1)MOV(Month_FIFO[1],Month1);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[EQU(DATE_TIME[1],1)MOV(Current_Month_Flow,Month1);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[EQU(Month_FIFO_CTL.POS,3)ONS(OneShot.2)MOV(Month_FIFO[2],Month2);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[EQU(DATE_TIME[1],2)MOV(Current_Month_Flow,Month2);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[EQU(Month_FIFO_CTL.POS,4)ONS(OneShot.3)MOV(Month_FIFO[3],Month3);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[EQU(DATE_TIME[1],3)MOV(Current_Month_Flow,Month3);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[EQU(Month_FIFO_CTL.POS,5)ONS(OneShot.4)MOV(Month_FIFO[4],Month4);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[EQU(DATE_TIME[1],4)MOV(Current_Month_Flow,Month4);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Text>
<![CDATA[EQU(Month_FIFO_CTL.POS,6)ONS(OneShot.5)MOV(Month_FIFO[5],Month5);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Text>
<![CDATA[EQU(DATE_TIME[1],5)MOV(Current_Month_Flow,Month5);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Text>
<![CDATA[EQU(Month_FIFO_CTL.POS,7)ONS(OneShot.6)MOV(Month_FIFO[6],Month6);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Text>
<![CDATA[EQU(DATE_TIME[1],6)MOV(Current_Month_Flow,Month6);]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Text>
<![CDATA[EQU(Month_FIFO_CTL.POS,8)ONS(OneShot.7)MOV(Month_FIFO[7],Month7);]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Text>
<![CDATA[EQU(DATE_TIME[1],7)MOV(Current_Month_Flow,Month7);]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Text>
<![CDATA[EQU(Month_FIFO_CTL.POS,9)ONS(OneShot.8)MOV(Month_FIFO[8],Month8);]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Text>
<![CDATA[EQU(DATE_TIME[1],8)MOV(Current_Month_Flow,Month8);]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Text>
<![CDATA[EQU(Month_FIFO_CTL.POS,10)ONS(OneShot.9)MOV(Month_FIFO[9],Month9);]]>
</Text>
</Rung>
<Rung Number="25" Type="N">
<Text>
<![CDATA[EQU(DATE_TIME[1],9)MOV(Current_Month_Flow,Month9);]]>
</Text>
</Rung>
<Rung Number="26" Type="N">
<Text>
<![CDATA[EQU(Month_FIFO_CTL.POS,11)ONS(OneShot.10)MOV(Month_FIFO[10],Month10);]]>
</Text>
</Rung>
<Rung Number="27" Type="N">
<Text>
<![CDATA[EQU(DATE_TIME[1],10)MOV(Current_Month_Flow,Month10);]]>
</Text>
</Rung>
<Rung Number="28" Type="N">
<Text>
<![CDATA[EQU(Month_FIFO_CTL.POS,12)ONS(OneShot.11)MOV(Month_FIFO[11],Month11);]]>
</Text>
</Rung>
<Rung Number="29" Type="N">
<Text>
<![CDATA[EQU(DATE_TIME[1],11)MOV(Current_Month_Flow,Month11);]]>
</Text>
</Rung>
<Rung Number="30" Type="N">
<Text>
<![CDATA[EQU(Month_FIFO_CTL.POS,1)ONS(OneShot.12)MOV(Month_FIFO[12],Month12);]]>
</Text>
</Rung>
<Rung Number="31" Type="N">
<Text>
<![CDATA[EQU(DATE_TIME[1],12)MOV(Current_Month_Flow,Month12);]]>
</Text>
</Rung>
<Rung Number="32" Type="N">
<Text>
<![CDATA[CPT(Anual_Flow,Month1+Month2+Month3+Month4+Month5+Month6+Month7+Month8+Month9+Month10+Month11+Month12);]]>
</Text>
</Rung>
</RLLContent>
